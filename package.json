{
  "name": "fly-chicken-whatsapp-gateway",
  "version": "1.0.0",
  "description": "WhatsApp OTP Gateway for Fly Chicken POS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.16",
    "cors": "^2.8.5",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.flychicken.gateway",
    "productName": "FlyChicken-WAGateway",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
